{
  "name": "vini-fight",
  "productName": "VINI FIGHT",
  "version": "2.0.0",
  "description": "VINI FIGHT — jogo de luta 2D cartunesco para PC e celular (paródia fictícia).",
  "main": "electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node tools/serve.js",
    "serve": "node tools/serve.js",
    "test": "node tools/test/smoke.js",
    "build:web": "node tools/build-web.js",
    "desktop": "npm run build:web && electron .",
    "build:win": "node tools/build-win.js",
    "android:add": "npm run build:web && npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "build:win:zip": "node tools/build-win.js --zip"
  },
  "build": {
    "appId": "com.vinifight.game",
    "productName": "VINI FIGHT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "VINI FIGHT"
    },
    "portable": {
      "artifactName": "VINI-FIGHT-portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.1"
  },
  "author": "Vinicius"
}
